# LiveKit Cloud WebRTC & Real-Time Agent
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>
VITE_LIVEKIT_URL=wss://<your-project>.livekit.cloud

# Sarvam AI (Indic Speech-to-Text Saaras v3, Text-to-Speech Bulbul v3, Vision OCR)
SARVAM_API_KEY=<your-sarvam-api-key>

# InsForge Sovereign Clinical Database & Storage
VITE_INSFORGE_URL=https://<your-project-id>.<region>.insforge.app
VITE_INSFORGE_ANON_KEY=<your-anon-key>
INSFORGE_URL=https://<your-project-id>.<region>.insforge.app
INSFORGE_ANON_KEY=<your-anon-key>
INSFORGE_API_KEY=<your-insforge-api-key>

# Groq Fast LLM API (openai/gpt-oss-20b for real-time adaptive quiz anamnesis)
VITE_GROQ_API_KEY=<your-groq-api-key>
GROQ_API_KEY=<your-groq-api-key>

# Pinata IPFS Decentralized Patient Storage
PINATA_API_KEY=<your-pinata-api-key>
PINATA_SECRET_KEY=<your-pinata-secret-key>
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
VITE_PINATA_API_KEY=<your-pinata-api-key>
VITE_PINATA_SECRET_KEY=<your-pinata-secret-key>
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Local Private MedGemma AI (Ollama)
MEDGEMMA_OLLAMA_URL=http://127.0.0.1:11434
MEDGEMMA_OLLAMA_MODEL=medgemma:4b
